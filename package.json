{
  "name": "heist-planner",
  "packageManager": "yarn@4.10.3",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.20",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~57.0.25",
    "expo-application": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@types/babel__core": "^7",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:clear": "expo start --dev-client --clear",
    "start:go": "expo start",
    "android": "expo start --android --dev-client",
    "ios": "expo start --ios --dev-client",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:check": "prettier . --check",
    "format:fix": "prettier . --write",
    "check": "yarn lint && yarn format && yarn typecheck",
    "fix": "yarn lint:fix && yarn format:fix",
    "doctor": "npx expo-doctor",
    "validate": "yarn typecheck && yarn lint && yarn format && yarn test --runInBand && yarn doctor",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepare": "husky",
    "build:dev": "npx eas-cli@latest build --profile development --platform all",
    "build:dev:ios": "npx eas-cli@latest build --profile development --platform ios",
    "build:dev:android": "npx eas-cli@latest build --profile development --platform android",
    "build:dev:simulator": "npx eas-cli@latest build --profile development-simulator --platform ios",
    "build:preview": "npx eas-cli@latest build --profile preview --platform all",
    "build:preview:ios": "npx eas-cli@latest build --profile preview --platform ios",
    "build:preview:android": "npx eas-cli@latest build --profile preview --platform android",
    "build:production": "npx eas-cli@latest build --profile production --platform all",
    "build:production:ios": "npx eas-cli@latest build --profile production --platform ios",
    "build:production:android": "npx eas-cli@latest build --profile production --platform android",
    "dev:android": "yarn build:dev:android",
    "dev:ios": "yarn build:dev:ios",
    "preview:android": "yarn build:preview:android",
    "preview:ios": "yarn build:preview:ios",
    "build:android": "yarn build:production:android",
    "build:ios": "yarn build:production:ios",
    "build:all": "yarn build:production",
    "update:development": "npx eas-cli@latest update --channel development --environment development",
    "update:preview": "npx eas-cli@latest update --channel preview --environment preview",
    "update:preview:ios": "npx eas-cli@latest update --channel preview --environment preview --platform ios",
    "update:preview:android": "npx eas-cli@latest update --channel preview --environment preview --platform android",
    "update:production": "npx eas-cli@latest update --channel production --environment production",
    "update:production:ios": "npx eas-cli@latest update --channel production --environment production --platform ios",
    "update:production:android": "npx eas-cli@latest update --channel production --environment production --platform android",
    "submit:ios": "npx eas-cli@latest submit --profile production --platform ios",
    "submit:android": "npx eas-cli@latest submit --profile production --platform android",
    "submit:all": "npx eas-cli@latest submit --profile production --platform all"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/"
    ]
  },
  "private": true
}
